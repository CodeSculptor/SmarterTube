<?xml version="1.0" encoding="utf-8"?>
<!-- Channel sort chip (Latest / Popular / Oldest): filled when selected, like YouTube. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/mobile_text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/mobile_chip_background" />
        </shape>
    </item>
</selector>
