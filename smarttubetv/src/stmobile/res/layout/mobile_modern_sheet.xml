<?xml version="1.0" encoding="utf-8"?>
<!--
    Modern player sheet (#46): a dim scrim with a bottom card listing either the other player
    actions (settings button / "more") or the up-next videos (More videos). Hosted in the player
    layout, not a dialog window, so opening it never disturbs the full-screen player (#29).
    Touch routing (tap outside = close) is handled by ModernPlayerChrome.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobile_modern_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/modern_sheet_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_modern_sheet"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#66FFFFFF" />

        <TextView
            android:id="@+id/modern_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/modern_sheet_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
