<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mobile_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/mobile_primary">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/mobile_text_primary"
            android:textSize="22sp"
            android:contentDescription="@string/mobile_offline_back"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/mobile_offline_title"
            android:singleLine="true"
            android:textColor="@color/mobile_text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_delete_all"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/mobile_offline_delete_all"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <TextView
        android:id="@+id/offline_usage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/offline_wifi_only"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:text="@string/mobile_offline_wifi_only"
        android:textColor="@color/mobile_text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/offline_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/mobile_offline_empty"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/offline_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
