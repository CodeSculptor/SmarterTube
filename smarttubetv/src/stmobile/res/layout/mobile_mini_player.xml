<?xml version="1.0" encoding="utf-8"?>
<!-- Mini-player bar (#96), docked under Home / Search / Channel while a video is minimised. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini_player_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/mobile_surface"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/mini_player_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="1000"
        android:progress="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/mini_player_poster"
            android:layout_width="80dp"
            android:layout_height="45dp"
            android:background="@color/mobile_thumbnail_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mobile_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mini_player_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mini_player_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_mini_player_play_pause"
            android:src="@drawable/ic_mini_pause"
            android:tint="@color/mobile_text_primary" />

        <ImageButton
            android:id="@+id/mini_player_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_mini_player_close"
            android:src="@drawable/ic_mini_close"
            android:tint="@color/mobile_text_primary" />
    </LinearLayout>
</LinearLayout>
